# ========================================================
# Multi-Agent Orchestrator Environment Configuration
# ========================================================

# --- LLM API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Google SMTP Email Authentication ---
# 1. Host and Port for Google SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 2. Your Google / Gmail Address
SMTP_USER=your_email@gmail.com

# 3. Google App Password (16 characters)
# How to get Google App Password:
#  a. Go to your Google Account (https://myaccount.google.com/)
#  b. Navigate to 'Security' -> Ensure '2-Step Verification' is ON
#  c. Search for 'App Passwords' (or visit https://myaccount.google.com/apppasswords)
#  d. Create a new app name (e.g. 'MultiAgentOrchestrator')
#  e. Copy the generated 16-character password and paste below (spaces are automatically stripped):
SMTP_PASSWORD=abcd efgh ijkl mnop

# 4. Display name for outbound verification emails
SMTP_SENDER_NAME=Multi-Agent Orchestrator

# 5. Security & Expiry Settings (Optional)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
